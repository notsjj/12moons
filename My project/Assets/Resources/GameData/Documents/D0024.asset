  documentId: D0024
  title: "\u5927\u516C\u4F1A"
  bodyText: "\u4E00\u4E9B\u6709\u52BF\u529B\u6276\u6301\u7684\u5927\u516C\u4F1A\u5728\u4E1A\u52A1\u4E0A\u6709\u5784\u65AD\u8D8B\u52BF\uFF0C\u4E00\u4E9B\u5C0F\u5DE5\u4F1A\u5DF2\u7ECF\u95E8\u53EF\u7F57\u96C0\uFF0C\u4E3A\u4E86\u5065\u5EB7\u7684\u5E02\u573A\u751F\u6001\uFF0C\u6700\u597D\u901A\u8FC7\u5E73\u8861\u4E00\u4E0B\u4EFB\u52A1\u53D1\u653E\u6765\u5E2E\u52A9\u8FD9\u4E9B\u5C0F\u5DE5\u4F1A\u7684\u751F\u5B58\u3002"
  proposerCharacterId: C0004
