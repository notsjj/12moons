    nextDocumentId: 
    nextDocumentDelayRound: 0
    unlockBuildingId: 
    resultText: 
    proposerFeedbackText: "\u8FD9\u662F\u5BF9\u4EBA\u6743\u7684\u5F7B\u5E95\u7269\u5316\u4E0E\u8DF5\u8E0F\u3002"
    feedbackFactionId: F0003
    factionFeedbackText: "\u53EA\u8981\u63D0\u6848\u901A\u8FC7\uFF0C\u4E3A\u4E86\u5229\u76CA\u4F1A\u5F00\u9664\u6240\u4EE5\u4E0D\u505A\u6539\u9020\u7684\u5DE5\u4EBA\u3002"
