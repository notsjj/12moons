  documentId: D0040
  title: "\u6548\u7387\u6539\u9020"
  bodyText: "\u6211\u4EEC\u7814\u7A76\u51FA\u4E86\u65B0\u7684\u9762\u90E8\u4E0E\u547C\u5438\u9053\u7684\u5EC9\u4EF7\u6539\u9020\uFF0C\u6539\u9020\u8005\u65E0\u60E7\u98CE\u5C18\u4E0E\u4E00\u90E8\u5206\u5316\u5B66\u6BD2\u6C14\uFF0C\u5403\u996D\u5219\u76F4\u63A5\u7528\u8425\u517B\u7CCA\u704C\u5165\u5373\u53EF\uFF0C\u80FD\u660E\u663E\u5730\u63D0\u9AD8\u6548\u7387\uFF0C\u5E0C\u671B\u53EF\u4EE5\u5728\u536B\u961F\u4E0E\u5DE5\u4EBA\u4E4B\u4E2D\u666E\u53CA\u3002"
  proposerCharacterId: C0011
  documentType: Task
  factionLogoName: "\u5B66\u9662"
  disasterId: DI0001
  disasterStageId: 
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
  optionA:
    text: "\u540C\u610F"
    moneyChange: 0
