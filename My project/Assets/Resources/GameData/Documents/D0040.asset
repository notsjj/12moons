    resultText: 
    proposerFeedbackText: "\u8FD9\u5BF9\u6548\u7387\u4E0E\u6536\u76CA\u6765\u8BF4\u662F\u81F3\u5173\u91CD\u8981\u7684\u3002"
    feedbackFactionId: F0003
    factionFeedbackText: "\u8FD9\u4E2A\u63D0\u6848\u662F\u4E3A\u4E86\u4ED6\u4EEC\u7684\u5065\u5EB7\u3002"
