  title: "\u5F3A\u5316\u624B\u672F"
  bodyText: "\u738B\u56FD\u7684\u58EB\u5175\u4EEC\u53EF\u4EE5\u63A5\u53D7\u5B66\u9662\u7684\u5F3A\u5316\u624B\u672F\u6765\u589E\u5F3A\u6218\u6597\u529B\uFF0C\u624B\u672F\u540E\u53EF\u80FD\u4F1A\u6709\u4E00\u4E9B\u7CBE\u795E\u5931\u5E38\u7684\u75C7\u72B6\uFF0C\u4E0D\u8FC7\u7EDD\u5BF9\u7455\u4E0D\u63A9\u745C\u3002"
  proposerCharacterId: C0011
  documentType: Task
  factionLogoName: "\u5B66\u9662"
  disasterId: DI0001
  disasterStageId: 
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
  optionA:
    text: "\u6279\u51C6\u6539\u9020"
