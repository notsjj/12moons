    factionFeedbackText: "\u6211\u4EEC\u6B63\u5728\u52A0\u7D27\u7814\u53D1\u65B0\u4E00\u4EE3\u4E49\u4F53\u4EE5\u66F4\u597D\u5730\u8FDB\u884C\u9002\u914D\u3002"
