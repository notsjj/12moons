    resultText: 
    proposerFeedbackText: "\u60A8\u4F1A\u770B\u5230\u673A\u68B0\u7684\u529B\u91CF\u5728\u4EBA\u8EAB\u4E0A\u7EFD\u653E\u7684\u3002"
    feedbackFactionId: F0002
    factionFeedbackText: "\u6240\u8C13\u201C\u672F\u540E\u7CBE\u795E\u75C5\u201D\u53EA\u662F\u8C23\u8A00\uFF0C\u8BF7\u5207\u83AB\u76F8\u4FE1\u3002"
