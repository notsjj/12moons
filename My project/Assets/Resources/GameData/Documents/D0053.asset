    resultText: 
    proposerFeedbackText: "\u60A8\u7684\u58EB\u5175\u5DF2\u7ECF\u843D\u4F0D\u4E86\uFF0C\u8BF7\u4E0D\u8981\u5FFD\u89C6\u8FD9\u4E00\u70B9\u3002"
