  documentId: D0039
  title: "\u5C38\u4F53\u5931\u7A83"
  bodyText: "\u6211\u4EEC\u9AD8\u8D35\u7684\u5BB6\u65CF\u5893\u5730\u4E4B\u4E2D\u7ADF\u7136\u51FA\u73B0\u4E86\u9057\u4F53\u5931\u7A83\u7684\u6848\u4EF6\uFF0C\u90A3\u4E9B\u5B66\u9662\u7684\u5BB6\u4F19\u7ADF\u7136\u4E3A\u4E86\u6240\u8C13\u7684\u79D1\u5B66\u800C\u4EB5\u6E0E\u901D\u8005\uFF0C\u6211\u73B0\u5728\u4E25\u6B63\u8981\u6C42\u5BF9\u5B66\u9662\u5C55\u5F00\u8C03\u67E5\uFF0C\u5FC5\u987B\u8981\u63EA\u51FA\u72AF\u6848\u8005\uFF01"
  proposerCharacterId: C0023
  documentType: Task
  factionLogoName: "\u738B\u5BA4"
  disasterId: DI0001
  disasterStageId: 
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
