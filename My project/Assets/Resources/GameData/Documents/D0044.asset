  documentId: D0044
  title: "\u6C34\u7BA1\u5835\u585E"
  bodyText: "\u6709\u4E00\u7FA4\u5815\u843D\u8005\u878D\u5408\u5230\u4E86\u4E00\u8D77\u5835\u6B7B\u4E86\u5B66\u9662\u90A3\u7247\u4E0B\u9762\uFF0C\u73B0\u5728\u9700\u8981\u5C06\u5176\u5F7B\u5E95\u706D\u6D3B\uFF0C\u4E00\u4E2A\u529E\u6CD5\u662F\u6D3E\u536B\u961F\u4E00\u70B9\u70B9\u7528\u706B\u70E7\uFF0C\u53E6\u4E00\u4E2A\u5219\u662F\u7528\u6BD2\u6C14\u628A\u5B83\u95F7\u6B7B\uFF0C\u4E0D\u8FC7\u53EF\u80FD\u4F1A\u8BEF\u4F24\u4E00\u4E9B\u6D41\u6D6A\u8005\u3002"
  proposerCharacterId: C0011
  documentType: Task
  factionLogoName: "\u5B66\u9662"
  disasterId: DI0001
  disasterStageId: 
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
  optionA:
