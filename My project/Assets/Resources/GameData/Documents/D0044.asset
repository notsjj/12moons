    factionFeedbackText: "\u4EC0\u4E48\u662F\u7406\u6027\uFF0C\u8BA9\u5E73\u6C11\u548C\u8089\u5757\u4E00\u8D77\u88AB\u6BD2\u6B7B\u5417\uFF1F"
