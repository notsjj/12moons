    resultText: 
    proposerFeedbackText: "\u5BF9\u75C5\u4EBA\u7684\u8D54\u6B3E\u4E00\u5206\u90FD\u4E0D\u80FD\u5C11\u3002"
    feedbackFactionId: F0002
    factionFeedbackText: "\u518D\u91CD\u7533\u4E00\u904D\uFF0C\u5455\u5410\u75C5\u60C5\u548C\u5DE5\u5382\u6CA1\u6709\u5173\u7CFB\u3002"
  optionB:
    text: "\u5047\u88C5\u4E0D\u77E5"
    moneyChange: 0
    materialChange: 0
    foodChange: 0
    nobleSuspicionChange: 0
    academySuspicionChange: 0
