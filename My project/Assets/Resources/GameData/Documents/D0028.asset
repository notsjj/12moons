  documentId: D0028
  title: "\u5455\u5410\u75C5"
  bodyText: "\u90A3\u4E9B\u5DE5\u5382\u76F4\u63A5\u671D\u6C34\u6E90\u91CC\u6392\u653E\u5DE5\u4E1A\u5E9F\u7269\uFF0C\u559D\u4E86\u8FD9\u4E9B\u6C34\u7684\u4EBA\u5C31\u4F1A\u6B62\u4E0D\u4F4F\u5730\u5455\u5410\uFF0C\u533B\u9662\u5DF2\u7ECF\u7126\u5934\u70C2\u989D\u4E86\u3002\u5B66\u9662\u5FC5\u987B\u4E3A\u6B64\u8D1F\u8D23\uFF01"
  proposerCharacterId: C0017
  documentType: Task
  factionLogoName: "\u6559\u4F1A"
  disasterId: DI0001
  disasterStageId: 
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
  optionA:
    text: "\u95EE\u8D23\u5B66\u9662"
    moneyChange: 0
    materialChange: 0
    foodChange: -1
    nobleSuspicionChange: 0
    academySuspicionChange: 0
