    addItemId: 
    addItemCount: 0
    nextDocumentId: 
    nextDocumentDelayRound: 0
    unlockBuildingId: 
    resultText: 
    proposerFeedbackText: "\u592A\u8352\u8C2C\u4E86\uFF0C\u60A8\u660E\u660E\u77E5\u9053\u662F\u8C01\u5BFC\u81F4\u4E86\u8FD9\u4E00\u5207\u3002"
    feedbackFactionId: F0002
    factionFeedbackText: "\u65E0\u975E\u662F\u60F3\u8981\u7D22\u53D6\u8D54\u6B3E\u7684\u5C0F\u624B\u6BB5\u800C\u5DF2\u3002"
