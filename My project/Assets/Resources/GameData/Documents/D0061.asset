  title: "\u706B\u836F\u5236\u54C1"
  bodyText: "\u6211\u591C\u89C2\u5929\u76F8\uFF0C\u53D1\u73B0\u4E0B\u57CE\u533A\u7684\u4E00\u5757\u6709\u8F70\u7136\u6BC1\u706D\u7684\u8D8B\u52BF\uFF0C\u8FC7\u53BB\u4E00\u770B\u5B66\u9662\u628A\u4E00\u5806\u8FC7\u671F\u706B\u836F\u5168\u5806\u5728\u90A3\u8FB9\u4E86\uFF0C\u4E0D\u5C11\u8FD8\u53D7\u6F6E\u4E86\uFF01\u8D76\u7D27\u8BA9\u5B66\u9662\u628A\u5B83\u4EEC\u5206\u6563\u50A8\u5B58\u6216\u8005\u9500\u6BC1\u4E86\uFF01"
  proposerCharacterId: C0014
  documentType: Task
  factionLogoName: "\u5B66\u9662"
