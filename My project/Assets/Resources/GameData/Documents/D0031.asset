    resultText: 
    proposerFeedbackText: "\u611F\u8C22\u60A8\u7684\u6279\u51C6\uFF0C\u62A4\u6559\u519B\uFF0C\u7ACB\u523B\u5C55\u5F00\u730E\u5DEB\u884C\u52A8\u3002"
    feedbackFactionId: F0002
    factionFeedbackText: "\u8FD9\u662F\u5BF9\u5B66\u9662\u6C11\u4F17\u7684\u4EBA\u8EAB\u4FB5\u5BB3\uFF0C\u6211\u4EEC\u5F3A\u70C8\u8C34\u8D23\u8FD9\u79CD\u65E0\u7AEF\u6C61\u8511\u3002"
