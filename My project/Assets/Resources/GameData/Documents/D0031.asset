  documentId: D0031
  title: "\u5F02\u7AEF\u8FFD\u730E"
  bodyText: "\u6211\u4EEC\u6709\u786E\u51FF\u7406\u7531\u76F8\u4FE1\uFF0C\u4E00\u4E2A\u5BA3\u4F20\u5E94\u8BE5\u7528\u795E\u672F\u63A7\u5236\u8D2B\u6C11\u5E76\u5077\u7A83\u6559\u4F1A\u9057\u7269\u7684\u5F02\u7AEF\u6B63\u8EB2\u85CF\u5728\u5B66\u9662\u4E4B\u4E2D\uFF0C\u4E3A\u4E86\u4FDD\u8BC1\u6293\u6355\u7684\u6210\u529F\u7387\uFF0C\u6211\u4EEC\u51C6\u5907\u7A81\u88AD\u4ED6\u7684\u85CF\u8EAB\u5904\uFF0C\u5E0C\u671B\u6279\u51C6\u6B64\u6B21\u7A81\u88AD\u3002"
  proposerCharacterId: C0016
  documentType: Task
  factionLogoName: "\u6559\u4F1A"
  disasterId: DI0001
  disasterStageId: 
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
  optionA:
    text: "\u540C\u610F"
