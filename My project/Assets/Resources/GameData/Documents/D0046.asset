  title: "\u706B\u707E\u9690\u60A3"
  bodyText: "\u4E0B\u57CE\u533A\u53C8\u51FA\u73B0\u4E86\u4E00\u573A\u706B\u707E\uFF0C\u867D\u7136\u90A3\u4E9B\u6CE5\u817F\u5B50\u600E\u4E48\u6837\u4E0D\u91CD\u8981\uFF0C\u4F46\u6211\u4EEC\u8FD8\u662F\u91CD\u65B0\u8003\u8651\u4E86\u4E00\u4E0B\u73B0\u5728\u7684\u6D88\u9632\u4F53\u7CFB\u3002\u4E3A\u4E86\u4FDD\u8BC1\u4E0D\u4F1A\u6709\u610F\u5916\u7684\u706B\u707E\u51FA\u73B0\uFF0C\u5F80\u4E0A\u57CE\u533A\u518D\u591A\u64AD\u70B9\u6D88\u9632\u6B3E\u5982\u4F55\uFF1F"
  proposerCharacterId: C0026
  documentType: Task
  factionLogoName: "\u8D35\u65CF"
  disasterId: DI0001
  disasterStageId: 
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
  optionA:
