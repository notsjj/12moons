    consumeItem: 0
    addItemId: 
    addItemCount: 0
    nextDocumentId: 
    nextDocumentDelayRound: 0
    unlockBuildingId: building_relief_depot
    resultText: "\u8D48\u6D4E\u4ED3\u5F00\u59CB\u642D\u5EFA\uFF0C\u57CE\u533A\u4E2D\u5BF9\u5E94\u5EFA\u7B51\u5E94\u4ECE\u9690\u85CF\u53D8\u4E3A\u663E\u793A\u3002"
    proposerFeedbackText: "\u7BA1\u4E8B\u9886\u5230\u5370\u4FE1\uFF0C\u7ACB\u523B\u6D3E\u4EBA\u642C\u8FD0\u6728\u6599\u3002"
    feedbackFactionId: civilian
    factionFeedbackText: "\u5C45\u6C11\u542C\u8BF4\u8D48\u6D4E\u4ED3\u5F00\u5DE5\uFF0C\u8D28\u7591\u7565\u964D\u3002"
  optionB:
    text: "\u6682\u7F13\u4FEE\u5EFA"
    moneyChange: 0
    materialChange: 0
    foodChange: 0
    nobleSuspicionChange: 0
    academySuspicionChange: 1
    churchSuspicionChange: 0
    civilianSuspicionChange: 2
