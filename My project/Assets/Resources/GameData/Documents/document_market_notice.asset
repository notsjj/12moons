    requiredItemId: 
    requiredItemCount: 0
    consumeItem: 0
    addItemId: 
    addItemCount: 0
    nextDocumentId: 
    nextDocumentDelayRound: 0
    unlockBuildingId: 
    resultText: "\u8D48\u6D4E\u4ED3\u56FE\u7EB8\u88AB\u9000\u56DE\uFF0C\u57CE\u533A\u4E2D\u5BF9\u5E94\u5EFA\u7B51\u4FDD\u6301\u9690\u85CF\u3002"
    proposerFeedbackText: "\u7BA1\u4E8B\u6536\u8D77\u56FE\u7EB8\uFF0C\u7B49\u5F85\u4E0B\u4E00\u6B21\u6279\u51C6\u3002"
    feedbackFactionId: civilian
    factionFeedbackText: "\u5C45\u6C11\u8BA4\u4E3A\u8BAE\u5385\u53C8\u63A8\u8FDF\u4E86\u8D48\u6D4E\u5B89\u6392\u3002"
