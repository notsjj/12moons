  documentId: document_market_notice
  title: "\u8D48\u6D4E\u4ED3\u4FEE\u5EFA\u4EE4"
  bodyText: "\u5E93\u623F\u7BA1\u4E8B\u5448\u4E0A\u4E34\u65F6\u8D48\u6D4E\u4ED3\u56FE\u7EB8\uFF0C\u8BF7\u6C42\u7ACB\u523B\u62E8\u51FA\u8BB8\u53EF\uFF0C\u5728\u738B\u5BAB\u95E8\u524D\u642D\u8D77\u53EF\u53CD\u590D\u53D1\u7CAE\u7684\u8D48\u6D4E\u4ED3\u3002"
  proposerCharacterId: character_steward
  documentType: Global
  factionLogoName: "\u5DE5\u4F1A"
  disasterId: 
  disasterStageId: 
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u9636\u6BB515\u5EFA\u7B51\u89E3\u9501\u6D4B\u8BD5\u516C\u6587"
  optionA:
    text: "\u6279\u51C6\u4FEE\u5EFA\u8D48\u6D4E\u4ED3"
    moneyChange: 0
    materialChange: 0
    foodChange: 0
    nobleSuspicionChange: 1
    academySuspicionChange: 0
    churchSuspicionChange: 0
    civilianSuspicionChange: -2
    taskScoreChange: 0
    requiredItemId: 
