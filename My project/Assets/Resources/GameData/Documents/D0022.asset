    factionFeedbackText: "\u597D\u7AEF\u7AEF\u7684\u7CAE\u98DF\u5C31\u88AB\u8FD9\u6837\u5B50\u7ED9\u4E86\u7A77\u4EBA\uFF0C\u7CDF\u8E4B\u554A\u3002"
