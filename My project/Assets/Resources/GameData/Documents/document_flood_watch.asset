    feedbackFactionId: civilian
    factionFeedbackText: "\u95F8\u53E3\u9644\u8FD1\u7684\u5C45\u6C11\u7EC8\u4E8E\u7761\u5F97\u5B89\u7A33\u4E9B\u3002"
