    resultText: "\u5FD7\u613F\u8005\u534A\u591C\u6563\u53BB\uFF0C\u95F8\u53E3\u53EA\u5269\u4E24\u76CF\u706F\u3002"
    proposerFeedbackText: "\u4FE1\u4F7F\u8BB0\u4E0B\u6CA1\u6709\u96C7\u961F\u7684\u51B3\u5B9A\u3002"
