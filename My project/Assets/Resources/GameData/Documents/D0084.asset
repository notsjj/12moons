    factionFeedbackText: "\u8FD9\u4E0D\u662F\u6709\u89E3\u51B3\u529E\u6CD5\u5417\uFF0C\u8FD9\u4E9B\u82B1\u53EF\u6BD4\u4F60\u4EEC\u7684\u5B66\u5F92\u8D35\u591A\u4E86\u3002"
