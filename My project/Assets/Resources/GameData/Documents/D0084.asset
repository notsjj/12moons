    nextDocumentDelayRound: 0
    unlockBuildingId: 
    resultText: 
    proposerFeedbackText: "\u90A3\u53EA\u80FD\u628A\u5DE5\u574A\u7684\u8C03\u6E29\u7CFB\u7EDF\u6682\u65F6\u5173\u4E86\uFF0C\u8BA9\u4ED6\u4EEC\u5F00\u7A97\u6563\u70ED\u5427\u3002"
