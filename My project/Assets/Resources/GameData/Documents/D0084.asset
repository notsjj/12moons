    factionFeedbackText: "\u8BA9\u5B66\u9662\u5173\u6389\u51E0\u4E2A\u5DE5\u574A\u4E5F\u53EF\u4EE5\u89E3\u51B3\u8FD9\u4E2A\u95EE\u9898\uFF01"
