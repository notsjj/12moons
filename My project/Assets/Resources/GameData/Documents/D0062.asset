  title: "\u66FF\u6362\u4E49\u4F53"
  bodyText: "\u6211\u7ECF\u8FC7\u79D1\u5B66\u4E14\u4E25\u683C\u7684\u5BF9\u6BD4\uFF0C\u5F97\u51FA\u7684\u7ED3\u8BBA\u662F\u628A\u5DE5\u4EBA\u7684\u56DB\u80A2\u90FD\u66FF\u6362\u6210\u4E49\u4F53\u867D\u7136\u8D35\u70B9\uFF0C\u4F46\u53EF\u4EE5\u63D0\u9AD8\u5F88\u591A\u6548\u7387\uFF0C\u8BF7\u4E0B\u4EE4\u63A8\u5E7F\u6539\u9020\u5427\u3002"
  proposerCharacterId: C0011
  documentType: Task
  factionLogoName: "\u5B66\u9662"
  disasterId: DI0001
  disasterStageId: 
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
  optionA:
