    nextDocumentDelayRound: 0
    unlockBuildingId: 
    resultText: 
    proposerFeedbackText: "\u5C31\u4E3A\u4E86\u90A3\u4E9B\u4E0D\u8010\u7528\u7684\u8089\u80F3\u818A\u8089\u817F\uFF1F"
