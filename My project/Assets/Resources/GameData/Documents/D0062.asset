    factionFeedbackText: "\u5DE5\u4EBA\u9000\u4F11\u4E4B\u540E\u662F\u4E0D\u662F\u8FD8\u8981\u56DE\u6536\u90A3\u4E9B\u4E49\u4F53\u7136\u540E\u628A\u4ED6\u4EEC\u4E22\u51FA\u53BB\u3002"
