    proposerFeedbackText: "\u9601\u4E0B\u4ED8\u6B3E\u5C31\u662F\u723D\u5FEB\u554A\u3002"
    feedbackFactionId: F0001
    factionFeedbackText: "\u8FD9\u4E9B\u5783\u573E\u4E49\u4F53\u90FD\u662F\u54EA\u91CC\u5192\u51FA\u6765\u7684\uFF01"
