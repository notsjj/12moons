    addItemId: 
    addItemCount: 0
    nextDocumentId: 
    nextDocumentDelayRound: 0
    unlockBuildingId: 
    resultText: 
    proposerFeedbackText: "\u54E6\uFF0C\u5443\uFF0C\u770B\u6765\u6211\u53EA\u80FD\u53BB\u81EA\u5DF1\u60F3\u529E\u6CD5\u4E86\u3002"
    feedbackFactionId: F0002
    factionFeedbackText: "\u8BF7\u5404\u4F4D\u5192\u9669\u8005\u6CE8\u610F\uFF0C\u4E0D\u8981\u4E3A\u4E86\u4FBF\u5B9C\u800C\u8D2D\u4E70\u672A\u7ECF\u8D28\u68C0\u7684\u4E49\u4F53\u3002"
