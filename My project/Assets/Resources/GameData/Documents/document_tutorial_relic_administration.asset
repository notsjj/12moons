    requiredItemCount: 0
    consumeItem: 0
    addItemId: 
    addItemCount: 0
    nextDocumentId: 
    nextDocumentDelayRound: 0
    unlockBuildingId: 
    resultText: "\u6388\u6743\u88AB\u6682\u7F13\uFF0C\u8FD1\u4F8D\u53EA\u597D\u91CD\u65B0\u89E3\u91CA\u4E3A\u4F55\u8FD9\u4E0D\u662F\u4E00\u4E2A\u597D\u4E3B\u610F\u3002"
    proposerFeedbackText: "\u6388\u6743\u88AB\u6682\u7F13\uFF0C\u8FD1\u4F8D\u53EA\u597D\u91CD\u65B0\u89E3\u91CA\u4E3A\u4F55\u8FD9\u4E0D\u662F\u4E00\u4E2A\u597D\u4E3B\u610F\u3002"
    feedbackFactionId: civilian
    factionFeedbackText: "\u65C1\u89C2\u8005\u5BF9\u65B0\u738B\u5BA4\u6D41\u7A0B\u4ECD\u7136\u534A\u4FE1\u534A\u7591\u3002"
