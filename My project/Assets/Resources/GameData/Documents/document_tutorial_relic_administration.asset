    addItemCount: 0
    nextDocumentId: 
    nextDocumentDelayRound: 0
    unlockBuildingId: 
    resultText: "\u5370\u7AE0\u843D\u4E0B\uFF0C\u653F\u52A1\u8F85\u52A9\u5904\u7406\u6D41\u7A0B\u88AB\u6B63\u5F0F\u542F\u7528\u3002"
    proposerFeedbackText: "\u4E66\u8BB0\u5B98\u6536\u8D77\u6279\u6587\uFF0C\u786E\u8BA4\u6D41\u7A0B\u5DF2\u7ECF\u751F\u6548\u3002"
    feedbackFactionId: civilian
    factionFeedbackText: "\u4F17\u4EBA\u5F00\u59CB\u627F\u8BA4\u8FD9\u4EF6\u9057\u7269\u80FD\u5904\u7406\u6700\u57FA\u7840\u7684\u653F\u52A1\u3002"
  optionB:
    text: "\u6682\u7F13\u542F\u7528"
    moneyChange: 0
    materialChange: 0
    foodChange: 0
    nobleSuspicionChange: 0
    academySuspicionChange: 0
    churchSuspicionChange: 0
    civilianSuspicionChange: 0
