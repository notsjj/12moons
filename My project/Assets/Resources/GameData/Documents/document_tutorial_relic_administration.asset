  documentId: document_tutorial_relic_administration
  title: "\u662F\u5426\u51C6\u8BB8\u542F\u7528\u9057\u7269\u8FDB\u884C\u653F\u52A1\u8F85\u52A9\u5904\u7406"
  bodyText: "\u738B\u5BA4\u4E66\u8BB0\u5B98\u5448\u4E0A\u4E00\u4EFD\u4E34\u65F6\u6388\u6743\uFF0C\u8BF7\u6C42\u51C6\u8BB8\u521A\u82CF\u9192\u7684\u9057\u7269\u534F\u52A9\u5904\u7406\u653F\u52A1\uFF0C\u5E76\u4EE5\u738B\u5BA4\u5370\u7AE0\u786E\u8BA4\u6D41\u7A0B\u6709\u6548\u3002"
  proposerCharacterId: character_steward
  documentType: Task
  factionLogoName: "\u5DE5\u4F1A"
  disasterId: DI0001
  disasterStageId: DS_TUTORIAL
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u5F00\u573AS0002\u516C\u6587\u6559\u5B66\u4E13\u7528"
  optionA:
    text: "\u51C6\u8BB8\u542F\u7528"
    moneyChange: 0
    materialChange: 0
    foodChange: 0
    nobleSuspicionChange: 0
    academySuspicionChange: 0
