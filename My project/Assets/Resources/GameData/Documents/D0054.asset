    factionFeedbackText: "\u53EA\u662F\u4E00\u6B21\u610F\u5916\u4E8B\u6545\uFF0C\u5B8C\u5168\u6CA1\u5FC5\u8981\u5982\u6B64\u5174\u5E08\u52A8\u4F17\u3002"
