    nextDocumentDelayRound: 0
    unlockBuildingId: 
    resultText: "\u8F66\u961F\u72EC\u81EA\u4E0A\u8DEF\uFF0C\u51E0\u888B\u7CAE\u5728\u5E02\u573A\u53E3\u5931\u8E2A\u3002"
