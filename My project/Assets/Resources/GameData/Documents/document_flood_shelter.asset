    resultText: "\u504F\u5385\u5728\u508D\u665A\u524D\u6253\u5F00\uFF0C\u6E7F\u900F\u7684\u4EBA\u7FA4\u6709\u4E86\u843D\u811A\u5904\u3002"
    proposerFeedbackText: "\u4FE1\u4F7F\u5E26\u8D70\u4E86\u5F00\u5385\u8BB8\u53EF\u3002"
    feedbackFactionId: civilian
    factionFeedbackText: "\u5C45\u6C11\u5728\u96E8\u591C\u627E\u5230\u5E72\u71E5\u5730\u9762\uFF0C\u8D28\u7591\u7565\u964D\u3002"
