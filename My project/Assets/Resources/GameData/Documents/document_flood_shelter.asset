    unlockBuildingId: 
    resultText: "\u504F\u5385\u7EE7\u7EED\u5173\u95ED\uFF0C\u4EBA\u7FA4\u6324\u5728\u6A90\u4E0B\u3002"
    proposerFeedbackText: "\u4FE1\u4F7F\u6CA1\u6709\u62FF\u5230\u5370\u7AE0\uFF0C\u53EA\u80FD\u56DE\u53BB\u590D\u547D\u3002"
