  title: "\u5F02\u7AEF\u9020\u7269"
  bodyText: "\u5B66\u9662\u6B63\u5728\u7814\u7A76\u7684\u67D0\u4E2A\u673A\u68B0\u9057\u7269\u62E5\u6709\u6781\u5F3A\u7684\u653B\u51FB\u6027\u7684\u540C\u65F6\u8FD8\u6709\u7740\u8FD1\u4E4E\u4EBA\u7684\u667A\u80FD\uFF0C\u751A\u81F3\u6253\u7B97\u590D\u8F9F\u524D\u6587\u660E\uFF0C\u8FD9\u4E2A\u5F02\u7AEF\u9020\u7269\u5C31\u662F\u5F7B\u5934\u5F7B\u5C3E\u7684\u5371\u9669\u56E0\u7D20\uFF0C\u6211\u4EEC\u5FC5\u987B\u5C06\u5176\u9500\u6BC1\u3002"
  proposerCharacterId: C0016
  documentType: Task
  factionLogoName: "\u6559\u4F1A"
  disasterId: DI0001
  disasterStageId: 
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
