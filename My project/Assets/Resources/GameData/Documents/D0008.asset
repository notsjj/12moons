  documentId: D0008
  title: "\u8D8A\u6743\u6269\u5F20"
  bodyText: "\u5B66\u9662\u5F00\u59CB\u5BF9\u4E0B\u57CE\u533A\u8FDB\u884C\u4E86\u6269\u5C55\uFF0C\u8D2D\u5165\u4E86\u4E0D\u5C11\u4E0B\u57CE\u533A\u7684\u5730\u76AE\u7528\u6765\u7ED9\u5916\u5730\u6765\u751F\u5EFA\u5B66\u5F92\u5BBF\u820D\u4E0E\u98DF\u5802\uFF0C\u4F46\u4ED6\u4EEC\u6CA1\u6709\u63D0\u4EA4\u7533\u8BF7\uFF0C\u8FD9\u662F\u8D8A\u6743\u884C\u4E3A\u2014\u2014\u90A3\u4E9B\u5730\u662F\u539F\u672C\u6211\u51C6\u5907\u5EFA\u5B64\u513F\u9662\u7684\u3002"
  proposerCharacterId: C0016
  documentType: Task
  factionLogoName: "\u6559\u4F1A"
  disasterId: DI0001
  disasterStageId: DS0003
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
  optionA:
    text: "\u540C\u610F\u5B66\u9662\u7EE7\u7EED"
    moneyChange: -1
    materialChange: 0
    foodChange: 0
    nobleSuspicionChange: 0
    academySuspicionChange: 0
    churchSuspicionChange: 0
    civilianSuspicionChange: 0
    taskScoreChange: 0
    requiredItemId: 
    requiredItemCount: 0
    consumeItem: 0
    addItemId: 
    addItemCount: 0
    nextDocumentId: 
    nextDocumentDelayRound: 0
    unlockBuildingId: 
    resultText: 
    proposerFeedbackText: "\u60A8\u4E0D\u660E\u767D\uFF0C\u8FD9\u4E0D\u4EC5\u4EC5\u662F\u4E00\u5757\u5730\uFF0C\u4ED6\u4EEC\u5728\u89C6\u4ED6\u4EBA\u7684\u89C4\u5219\u4E8E\u65E0\u7269\u3002"
    feedbackFactionId: F0002
    factionFeedbackText: "\u65F6\u95F4\u4E0D\u7B49\u4EBA\uFF0C\u6211\u4EEC\u6709\u90A3\u4E48\u591A\u65B0\u5B66\u5F92\u3002"
  optionB:
    text: "\u5236\u6B62\u5B66\u9662\u7EE7\u7EED"
    moneyChange: 0
    materialChange: 0
    foodChange: 0
    nobleSuspicionChange: 0
    academySuspicionChange: 0
    churchSuspicionChange: 0
    civilianSuspicionChange: 0
