    requiredItemCount: 0
    consumeItem: 0
    addItemId: 
    addItemCount: 0
    nextDocumentId: 
    nextDocumentDelayRound: 0
    unlockBuildingId: 
    resultText: 
    proposerFeedbackText: "\u611F\u8C22\u60A8\uFF0C\u73B0\u5728\u6211\u4EEC\u7684\u5B64\u513F\u7684\u53BB\u5904\u6709\u7740\u843D\u4E86\u3002"
    feedbackFactionId: F0002
    factionFeedbackText: "\u90A3\u6211\u4EEC\u7684\u5B66\u5F92\u53BB\u54EA\u91CC\uFF1F"
