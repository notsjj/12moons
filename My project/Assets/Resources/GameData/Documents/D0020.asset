    nextDocumentId: 
    nextDocumentDelayRound: 0
    unlockBuildingId: 
    resultText: 
    proposerFeedbackText: "\u65E0\u59A8\uFF0C\u62A4\u6559\u519B\u4F1A\u81EA\u5DF1\u6293\u4F4F\u90A3\u53EA\u755C\u751F\u7684\u3002"
