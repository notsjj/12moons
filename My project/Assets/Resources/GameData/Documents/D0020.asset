  documentId: D0020
  title: "\u8BE1\u5F02\u52A8\u9759"
  bodyText: "\u6559\u533A\u7684\u8FB9\u754C\u5904\u51FA\u73B0\u4E86\u5F88\u591A\u5947\u602A\u7684\u722A\u75D5\uFF0C\u53EF\u80FD\u662F\u67D0\u79CD\u5371\u9669\u751F\u7269\u3002\u4E3A\u4E86\u5E73\u6C11\u7684\u5B89\u5168\uFF0C\u6211\u6709\u8D23\u4EFB\u5728\u6B64\u8BF7\u6C42\u60A8\u5BF9\u6B64\u5C55\u5F00\u8C03\u67E5\u2026\u2026\u5C24\u5176\u662F\u5BF9\u4E8E\u5B66\u9662\u90A3\u8FB9\uFF0C\u4ED6\u4EEC\u4ECE\u6765\u7BA1\u4E0D\u597D\u5B9E\u9A8C\u52A8\u7269\u3002"
  proposerCharacterId: C0020
  documentType: Task
  factionLogoName: "\u6559\u4F1A"
  disasterId: DI0001
  disasterStageId: 
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
  optionA:
    text: "\u540C\u610F"
    moneyChange: -1
    materialChange: 0
    foodChange: 0
    nobleSuspicionChange: 0
    academySuspicionChange: 0
