    resultText: 
    proposerFeedbackText: "\u6211\u4E0D\u4F1A\u5BB9\u5FCD\u4EB5\u6E0E\u4E4B\u7269\u5371\u5BB3\u795E\u7684\u4FE1\u5F92\u7684\u3002"
    feedbackFactionId: F0002
    factionFeedbackText: "\u8FD9\u7B80\u76F4\u5C31\u662F\u6BEB\u65E0\u4F9D\u636E\u7684\u6307\u63A7\u3002"
