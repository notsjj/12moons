  documentId: D0002
  title: "\u9884\u77E5\xB7\u9632\u6B62\u75AB\u75C5"
  bodyText: "\u6211\u542C\u8BF4\u4E86\u66B4\u96E8\u8981\u6765\u4E86\uFF0C\u800C\u4E14\u8FD8\u4F1A\u6709\u4E0D\u5C11\u4EBA\u751F\u75C5\uFF1F\u6211\u5DF2\u7ECF\u548C\u90A3\u4E2A\u516C\u4F1A\u957F\u5546\u91CF\u8FC7\u4E86\uFF0C\u5979\u628A\u540E\u52E4\u501F\u6211\uFF0C\u6211\u4E5F\u558A\u70B9\u4EBA\uFF0C\u63D0\u524D\u51C6\u5907\u4E00\u6279\u5E38\u7528\u836F\uFF0C\u4F46\u9700\u8981\u4E00\u70B9\u7ECF\u8D39\u3002"
  proposerCharacterId: C0001
  documentType: Task
  factionLogoName: "\u9ED1\u5E2E"
  disasterId: DI0001
  disasterStageId: DS0007
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u540E\u7EED\u516C\u6587\u793A\u4F8B\uFF1B\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
