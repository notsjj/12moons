  documentId: D0035
  title: "\u79FB\u52A8\u9910\u8F66"
  bodyText: "\u6211\u4EEC\u5E94\u5F53\u7EC4\u5EFA\u79FB\u52A8\u9910\u8F66\u961F\u4F0D\uFF0C\u4E00\u8FB9\u5411\u96BE\u6C11\u5206\u53D1\u98DF\u7269\u4E00\u8FB9\u5E03\u9053\uFF0C\u65E2\u80FD\u5E2E\u52A9\u4EBA\u4EEC\u53C8\u80FD\u4F20\u64AD\u795E\u8C15\uFF0C\u4F46\u5927\u796D\u53F8\u89C9\u5F97\u7EAF\u7CB9\u7684\u65BD\u820D\u53EA\u4F1A\u9002\u5F97\u5176\u53CD\uFF0C\u5E0C\u671B\u60A8\u53EF\u4EE5\u4E3A\u6211\u4EEC\u63D0\u4F9B\u4E00\u4E9B\u98DF\u7269\u3002"
  proposerCharacterId: C0017
  documentType: Task
  factionLogoName: "\u6559\u4F1A"
  disasterId: DI0001
  disasterStageId: 
  taskId: 
  taskStageId: 
  isRepeatable: 0
  remark: "\u8865\u8D44\u6E90\u63D0\u4EA4\u9700\u6C42\uFF1A\u7528\u4E8E\u516C\u6587\u7269\u54C1\u9762\u677F\u5F39\u51FA\u6D4B\u8BD5\u3002"
  optionA:
