    factionFeedbackText: "\u8F66\u961F\u5C06\u81EA\u738B\u5BAB\u51FA\u53D1\uFF0C\u4E00\u76F4\u884C\u9A76\u5230\u4E0B\u57CE\u533A\u7684\u6700\u8FB9\u7F18\u3002"
